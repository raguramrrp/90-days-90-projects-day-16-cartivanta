# CARTIVANTA - Environment Configuration
APP_NAME=CARTIVANTA
APP_ENV=development
DEBUG=True

# Database Configuration
# Primary: PostgreSQL
DB_ENGINE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cartivanta_db
DB_USER=postgres
DB_PASSWORD=postgres

# Alternative / Fallback: SQLite
# Set DB_ENGINE=sqlite to use local SQLite file
SQLITE_DB_PATH=data/cartivanta.db

# Processing Configuration
CHUNK_SIZE=50000
DATASET_CURRENCY=GBP
RANDOM_SEED=42

# Web Server
HOST=127.0.0.1
PORT=8000
